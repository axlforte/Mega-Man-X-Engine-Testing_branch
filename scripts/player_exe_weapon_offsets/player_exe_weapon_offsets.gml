function player_exe_weapon_offsets() {
	var _boff = 4;
	player_weapon_offset("shoot", 0, 6 + _boff, -4);
	player_weapon_offset("shoot", 1, 4 + _boff, -4);

	player_weapon_offset("super_shoot", 0, 14 + _boff, -5);
	player_weapon_offset("super_shoot_c", 0, 19 + _boff, 2);

	player_weapon_offset("walk", 0, 7 + _boff, -4);
	player_weapon_offset("walk", 1, 9 + _boff, -4);
	player_weapon_offset("walk", 2, 8 + _boff, -4);
	player_weapon_offset("walk", 3, 8 + _boff, -3);
	player_weapon_offset("walk", 4, 9 + _boff, -3);
	player_weapon_offset("walk", 5, 10 + _boff, -4);
	player_weapon_offset("walk", 6, 12 + _boff, -4);
	player_weapon_offset("walk", 7, 12 + _boff, -3);
	player_weapon_offset("walk", 8, 11 + _boff, -4);

	player_weapon_offset("shooting", 0, 12 + _boff, -3);
	player_weapon_offset("shooting", 1, 12 + _boff, -3);

	player_weapon_offset("jump", 0, 6 + _boff, -1);
	player_weapon_offset("jump", 1, 6 + _boff, -2);
	player_weapon_offset("jump", 2, 4 + _boff, -7);//
	player_weapon_offset("jump", 3, 4 + _boff, -8);
	player_weapon_offset("jump", 4, 4 + _boff, -8);
	player_weapon_offset("jump", 5, 5 + _boff, -1);
	player_weapon_offset("jump", 6, 6 + _boff, -1);

	player_weapon_offset("dash", 0, 9 + _boff, -2);
	player_weapon_offset("dash", 1, 10 + _boff, 3);

	player_weapon_offset("crouch", 0, 6 + _boff, -1);
	player_weapon_offset("crouch", 1, 6 + _boff, 1);
	player_weapon_offset("crouch", 2, 9 + _boff, 5);

	player_weapon_offset("wall", 0, 4 + _boff, -9);
	player_weapon_offset("wall", 1, 6 + _boff, -4);
	player_weapon_offset("wall", 2, 3 + _boff, -4);
	player_weapon_offset("wall", 3, 4 + _boff, -7);
	player_weapon_offset("wall", 4, 3 + _boff, -6);


}
